# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text diff=csharp
*.csproj text diff=csharp
*.sln text eol=crlf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text
*.txt text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.7z binary
*.tar binary
*.gz binary

# Executables
*.exe binary
*.dll binary
